<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<aside class="sidebar">
    <a class="brand" href="availability.jsp">&#x1F331; campus<span>green</span></a>

    <nav class="nav">
        <a class="nav-link ${activePage == 'book' ? 'active' : ''}" href="availability.jsp">&#x1F68C; Book a ride</a>
        <a class="nav-link ${activePage == 'impact' ? 'active' : ''}" href="myBookings.jsp">&#x1F4CA; My impact</a>
        <a class="nav-link ${activePage == 'leaderboard' ? 'active' : ''}" href="leaderboard.jsp">&#x1F3C6; Leaderboard</a>
    </nav>

    <div class="side-bottom">
        <div class="saved">
            <small>Saved so far</small>
            <b><fmt:formatNumber value="${sessionScope.student.totalCo2SavedKg}" maxFractionDigits="2" /> kg</b>
        </div>
        <div class="user">
            <span class="avatar">${fn:toUpperCase(fn:substring(sessionScope.student.name, 0, 1))}</span>
            <span class="user-name"><c:out value="${sessionScope.student.name}" /></span>
            <a class="logout" href="logout.jsp">Log out</a>
        </div>
    </div>
</aside>
